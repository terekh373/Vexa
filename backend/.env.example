# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://vexa:vexa@localhost:5432/vexa?schema=public"

# --- Cache / sessions ---------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth ---------------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-in-local-env"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-in-local-env"
JWT_REFRESH_TTL="30d"

# --- Platform economics -------------------------------------------------------
# Default commission in basis points: 1500 = 15.00%
PLATFORM_COMMISSION_BPS="1500"
# Minimum payout amount, kopiykas: 50000 = 500.00 UAH
PAYOUT_MIN_AMOUNT="50000"
# Refund window in days (TZ section 26)
REFUND_WINDOW_DAYS="14"

# --- Object storage (S3-compatible) -------------------------------------------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="vexa-dev"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_SIGNED_URL_TTL_SEC="600"

# --- Video (Cloudflare Stream) ------------------------------------------------
CF_STREAM_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""

# --- Payments (sandbox only during the diploma) -------------------------------
PAYMENT_PROVIDER="LIQPAY"
LIQPAY_PUBLIC_KEY="sandbox_"
LIQPAY_PRIVATE_KEY="sandbox_"
PAYMENT_WEBHOOK_URL="http://localhost:3000/api/payments/webhook"
