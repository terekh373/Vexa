// Vexa — educational marketplace. Database schema (MVP scope, TZ section 28.2).
// Conventions:
//  - PK: uuid generated by Postgres (gen_random_uuid, built-in since PG13).
//  - Every table has created_at / updated_at. Soft delete (deleted_at) only where
//    history must survive: users, courses, orders.
//  - Money is stored in integer kopiykas (UAH * 100). Never float.
//  - Commission is stored in basis points (1500 bps = 15.00%).
//  - DB identifiers are snake_case (@map / @@map), TS code stays camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  AUTHOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

/// COURSE = passed online in the player, MATERIAL = downloadable file pack.
enum ContentType {
  COURSE
  MATERIAL
}

/// Lifecycle from TZ 15.6: draft -> moderation -> published / rejected -> unpublished.
enum CourseStatus {
  DRAFT
  MODERATION
  PUBLISHED
  REJECTED
  UNPUBLISHED
}

enum LessonType {
  VIDEO
  TEXT
  FILE
  QUIZ
}

enum FileKind {
  COVER
  AVATAR
  VIDEO
  ATTACHMENT
}

/// S3 = documents/images, CLOUDFLARE_STREAM = HLS video (no own pipeline on MVP).
enum StorageProvider {
  S3
  CLOUDFLARE_STREAM
}

enum QuestionType {
  SINGLE
  MULTIPLE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum EnrollmentSource {
  PURCHASE
  ADMIN_GRANT
  FREE
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  LIQPAY
  WAYFORPAY
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

/// Signed ledger operations on the author balance.
enum BalanceEntryType {
  SALE
  REFUND
  PAYOUT
  ADJUSTMENT
}

enum PayoutMethod {
  CARD
  IBAN
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ModerationAction {
  SUBMITTED
  APPROVED
  REJECTED
  UNPUBLISHED
}

enum ComplaintTargetType {
  COURSE
  REVIEW
  USER
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum NotificationType {
  ACCOUNT
  PURCHASE
  MODERATION
  PAYOUT
  REVIEW
  SYSTEM
}

// ---------------------------------------------------------------------------
// USERS & AUTH
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String  @unique @db.VarChar(255)
  /// Null for accounts created via Google OAuth only.
  passwordHash String? @map("password_hash") @db.VarChar(255)
  fullName     String  @map("full_name") @db.VarChar(160)
  /// One account can hold several roles (a student may also be an author).
  roles        UserRole[]  @default([STUDENT])
  status       UserStatus  @default(ACTIVE)
  locale       String      @default("uk") @db.VarChar(5)
  googleId     String?     @unique @map("google_id") @db.VarChar(64)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  avatarFileId    String?   @map("avatar_file_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  avatar            File?            @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  authorProfile     AuthorProfile?
  balance           Balance?
  cart              Cart?
  refreshTokens     RefreshToken[]
  uploadedFiles     File[]           @relation("FileUploader")
  courses           Course[]         @relation("CourseAuthor")
  orders            Order[]
  orderItems        OrderItem[]      @relation("OrderItemAuthor")
  enrollments       Enrollment[]
  quizAttempts      QuizAttempt[]
  reviews           Review[]
  balanceEntries    BalanceEntry[]
  payouts           Payout[]         @relation("PayoutAuthor")
  processedPayouts  Payout[]         @relation("PayoutProcessedBy")
  notifications     Notification[]
  complaintsFiled   Complaint[]      @relation("ComplaintReporter")
  complaintsHandled Complaint[]      @relation("ComplaintResolvedBy")
  moderationActions ModerationLog[]  @relation("ModerationModerator")

  @@index([status])
  @@map("users")
}

/// Public author page: portfolio, verification badge, cached rating.
model AuthorProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  displayName String  @map("display_name") @db.VarChar(160)
  headline    String? @db.VarChar(255)
  bio         String? @db.Text
  websiteUrl  String? @map("website_url") @db.VarChar(255)

  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)

  /// Per-author override of the platform commission; null = default from config.
  commissionRateBps Int? @map("commission_rate_bps")

  // Denormalized counters, recalculated by services. Never trusted as source of truth.
  ratingAvg    Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewsCount Int     @default(0) @map("reviews_count")
  studentsCount Int    @default(0) @map("students_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("author_profiles")
}

/// Hashed refresh tokens (rotation + revoke). Access tokens stay stateless.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// TAXONOMY: catalog categories + school curriculum (NUSH)
// ---------------------------------------------------------------------------

model Category {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  slug     String  @unique @db.VarChar(120)
  nameUk   String  @map("name_uk") @db.VarChar(120)
  nameEn   String? @map("name_en") @db.VarChar(120)
  iconKey  String? @map("icon_key") @db.VarChar(64)
  sortOrder Int    @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  courses  Course[]

  @@index([parentId])
  @@map("categories")
}

/// School subject reference book: subject -> grade -> topic (TZ 15.3 / 15.6).
model CurriculumSubject {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug   String @unique @db.VarChar(120)
  nameUk String @map("name_uk") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  topics CurriculumTopic[]

  @@map("curriculum_subjects")
}

model CurriculumTopic {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  /// School grade 1..11 (null = out of school program, e.g. exam prep).
  grade     Int?
  title     String @db.VarChar(255)
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subject      CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courseTopics CourseTopic[]

  @@unique([subjectId, grade, title])
  @@index([subjectId, grade])
  @@map("curriculum_topics")
}

/// M:N — one material may cover several curriculum topics.
model CourseTopic {
  courseId String @map("course_id") @db.Uuid
  topicId  String @map("topic_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  course Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic  CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([courseId, topicId])
  @@index([topicId])
  @@map("course_topics")
}

// ---------------------------------------------------------------------------
// FILES
// ---------------------------------------------------------------------------

model File {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadedById String?         @map("uploaded_by_id") @db.Uuid
  kind         FileKind
  provider     StorageProvider @default(S3)
  /// S3 object key, or Cloudflare Stream video UID.
  storageKey   String          @map("storage_key") @db.VarChar(512)
  originalName String          @map("original_name") @db.VarChar(255)
  mimeType     String          @map("mime_type") @db.VarChar(127)
  sizeBytes    BigInt          @map("size_bytes")
  /// Video duration, seconds (null for documents).
  durationSec  Int?            @map("duration_sec")
  isReady      Boolean         @default(true) @map("is_ready")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  uploadedBy   User?         @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  userAvatars  User[]        @relation("UserAvatar")
  courseCovers Course[]      @relation("CourseCover")
  lessonVideos Lesson[]      @relation("LessonVideo")
  lessonFiles  LessonFile[]
  courseFiles  CourseFile[]

  @@index([uploadedById])
  @@map("files")
}

// ---------------------------------------------------------------------------
// CONTENT: courses / modules / lessons
// ---------------------------------------------------------------------------

model Course {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId String       @map("author_id") @db.Uuid
  categoryId String     @map("category_id") @db.Uuid
  coverFileId String?   @map("cover_file_id") @db.Uuid
  type     ContentType
  status   CourseStatus @default(DRAFT)

  slug             String   @unique @db.VarChar(180)
  title            String   @db.VarChar(180)
  shortDescription String   @map("short_description") @db.VarChar(400)
  description      String   @db.Text
  /// "What you will learn" bullets.
  outcomes         String[] @default([])
  /// Search keywords supplied by the author. Included in the catalog tsvector.
  tags             String[] @default([])
  language         String   @default("uk") @db.VarChar(5)
  /// Target school grade for filtering (null = not tied to a grade).
  grade            Int?

  /// Price in kopiykas. 0 = free content.
  priceAmount Int    @default(0) @map("price_amount")
  currency    String @default("UAH") @db.VarChar(3)

  // Denormalized counters for the catalog (recalculated by services).
  ratingAvg    Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewsCount Int     @default(0) @map("reviews_count")
  studentsCount Int    @default(0) @map("students_count")
  lessonsCount Int     @default(0) @map("lessons_count")
  durationSec  Int     @default(0) @map("duration_sec")

  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  author        User            @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cover         File?           @relation("CourseCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  modules       Module[]
  courseFiles   CourseFile[]
  topics        CourseTopic[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  enrollments   Enrollment[]
  reviews       Review[]
  moderationLog ModerationLog[]

  @@index([status, categoryId])
  @@index([status, publishedAt])
  @@index([authorId, status])
  @@index([type, status])
  /// Trigram index for typo-tolerant autocomplete (pg_trgm, enabled in migration 2).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "courses_title_trgm_idx")
  @@map("courses")
}

model Module {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String @map("course_id") @db.Uuid
  title     String @db.VarChar(180)
  /// Position inside the course. Not unique on purpose: reordering does bulk updates.
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sortOrder])
  @@map("modules")
}

model Lesson {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId    String     @map("module_id") @db.Uuid
  type        LessonType
  title       String     @db.VarChar(180)
  sortOrder   Int        @default(0) @map("sort_order")
  /// Free preview lesson, visible to guests (TZ 14.1).
  isFreePreview Boolean  @default(false) @map("is_free_preview")

  /// Filled for TEXT lessons (markdown/HTML).
  textContent String? @map("text_content") @db.Text
  /// Filled for VIDEO lessons.
  videoFileId String? @map("video_file_id") @db.Uuid
  durationSec Int?    @map("duration_sec")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  video     File?            @relation("LessonVideo", fields: [videoFileId], references: [id], onDelete: SetNull)
  files     LessonFile[]
  quiz      Quiz?
  progress  LessonProgress[]

  @@index([moduleId, sortOrder])
  @@map("lessons")
}

/// Attachments of a lesson (FILE lessons and extra handouts of video lessons).
model LessonFile {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String @map("lesson_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file   File   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([lessonId, fileId])
  @@map("lesson_files")
}

/// File pack of a MATERIAL course (no player, direct download after purchase).
model CourseFile {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String @map("course_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  title     String @db.VarChar(180)
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  file   File   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([courseId, fileId])
  @@map("course_files")
}

// ---------------------------------------------------------------------------
// QUIZZES
// ---------------------------------------------------------------------------

model Quiz {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// One quiz per QUIZ lesson.
  lessonId String @unique @map("lesson_id") @db.Uuid
  title    String @db.VarChar(180)
  /// Passing threshold, percent of max score.
  passScore Int   @default(60) @map("pass_score")
  timeLimitSec Int? @map("time_limit_sec")
  attemptsAllowed Int? @map("attempts_allowed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId    String       @map("quiz_id") @db.Uuid
  type      QuestionType @default(SINGLE)
  text      String       @db.Text
  points    Int          @default(1)
  sortOrder Int          @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  quiz     Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options  AnswerOption[]
  answers  QuizAttemptAnswer[]

  @@index([quizId, sortOrder])
  @@map("questions")
}

model AnswerOption {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  text       String  @db.Text
  /// Never sent to the student client.
  isCorrect  Boolean @default(false) @map("is_correct")
  sortOrder  Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder])
  @@map("answer_options")
}

model QuizAttempt {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId   String @map("quiz_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  score    Int    @default(0)
  maxScore Int    @default(0) @map("max_score")
  isPassed Boolean @default(false) @map("is_passed")

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  quiz    Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@index([quizId, userId])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId  String   @map("attempt_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  /// Selected option ids. Array instead of a join table: answers are written once
  /// and always read as a whole set.
  selectedOptionIds String[] @map("selected_option_ids") @db.Uuid
  isCorrect  Boolean  @default(false) @map("is_correct")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("quiz_attempt_answers")
}

// ---------------------------------------------------------------------------
// ACCESS & PROGRESS
// ---------------------------------------------------------------------------

/// Server-side proof of access to paid content. Created only by the payment webhook.
model Enrollment {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  courseId    String           @map("course_id") @db.Uuid
  orderItemId String?          @unique @map("order_item_id") @db.Uuid
  source      EnrollmentSource @default(PURCHASE)

  progressPercent Int       @default(0) @map("progress_percent")
  lastLessonId    String?   @map("last_lesson_id") @db.Uuid
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  /// Revoked on refund — access is closed without deleting the history.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  orderItem OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  progress  LessonProgress[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId   String         @map("enrollment_id") @db.Uuid
  lessonId       String         @map("lesson_id") @db.Uuid
  status         ProgressStatus @default(NOT_STARTED)
  watchedSeconds Int            @default(0) @map("watched_seconds")
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

// ---------------------------------------------------------------------------
// COMMERCE: cart / orders / payments
// ---------------------------------------------------------------------------

model Cart {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId   String @map("cart_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId])
  @@map("cart_items")
}

model Order {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-readable number for receipts and support.
  number      Int         @unique @default(autoincrement())
  userId      String      @map("user_id") @db.Uuid
  status      OrderStatus @default(PENDING)
  totalAmount Int         @map("total_amount")
  currency    String      @default("UAH") @db.VarChar(3)

  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  refundedAt  DateTime? @map("refunded_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([userId, status])
  @@map("orders")
}

/// Financial snapshot of one purchased item. Commission and author share are
/// calculated once, at payment confirmation, and never recomputed on read.
model OrderItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId  String @map("order_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid

  /// Title at purchase time — the course may be renamed later.
  titleSnapshot     String @map("title_snapshot") @db.VarChar(180)
  priceAmount       Int    @map("price_amount")
  commissionRateBps Int    @map("commission_rate_bps")
  commissionAmount  Int    @map("commission_amount")
  authorAmount      Int    @map("author_amount")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  author        User           @relation("OrderItemAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  enrollment    Enrollment?
  balanceEntries BalanceEntry[]

  @@unique([orderId, courseId])
  @@index([authorId])
  @@map("order_items")
}

model Payment {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId  String          @map("order_id") @db.Uuid
  provider PaymentProvider
  /// Transaction id on the provider side.
  providerPaymentId String? @map("provider_payment_id") @db.VarChar(128)
  status   PaymentStatus   @default(CREATED)
  amount   Int
  currency String          @default("UAH") @db.VarChar(3)
  /// Last provider response, kept for reconciliation and debugging.
  payload  Json?
  failureReason String?    @map("failure_reason") @db.VarChar(255)
  processedAt   DateTime?  @map("processed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order  Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentWebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@map("payments")
}

/// Raw webhook log. Unique external id makes webhook handling idempotent:
/// a repeated callback from the provider cannot open access twice.
model PaymentWebhookEvent {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId  String?         @map("payment_id") @db.Uuid
  provider   PaymentProvider
  externalId String          @map("external_id") @db.VarChar(191)
  payload    Json
  signatureValid Boolean     @default(false) @map("signature_valid")
  processedAt DateTime?      @map("processed_at") @db.Timestamptz(6)
  error      String?         @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@map("payment_webhook_events")
}

// ---------------------------------------------------------------------------
// AUTHOR MONEY: balance ledger + payouts
// ---------------------------------------------------------------------------

/// Cached aggregate of balance_entries. Updated in the same transaction as the ledger.
model Balance {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String @unique @map("user_id") @db.Uuid
  availableAmount Int    @default(0) @map("available_amount")
  /// Funds inside the refund window (14 days per TZ 26).
  pendingAmount   Int    @default(0) @map("pending_amount")
  withdrawnAmount Int    @default(0) @map("withdrawn_amount")
  currency        String @default("UAH") @db.VarChar(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("balances")
}

/// Append-only ledger: the source of truth for author money.
model BalanceEntry {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        BalanceEntryType
  /// Signed: SALE > 0, PAYOUT / REFUND < 0.
  amount      Int
  orderItemId String?          @map("order_item_id") @db.Uuid
  payoutId    String?          @map("payout_id") @db.Uuid
  comment     String?          @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  payout    Payout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("balance_entries")
}

model Payout {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId String       @map("author_id") @db.Uuid
  amount   Int
  currency String       @default("UAH") @db.VarChar(3)
  method   PayoutMethod
  /// Masked destination only (e.g. "**** 4242"). Full requisites are never stored.
  destinationMasked String @map("destination_masked") @db.VarChar(64)
  status   PayoutStatus @default(REQUESTED)
  comment  String?      @db.VarChar(255)

  processedById String?   @map("processed_by_id") @db.Uuid
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  author      User           @relation("PayoutAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  processedBy User?          @relation("PayoutProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  entries     BalanceEntry[]

  @@index([authorId, status])
  @@map("payouts")
}

// ---------------------------------------------------------------------------
// SOCIAL & OPERATIONS
// ---------------------------------------------------------------------------

model Review {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String       @map("course_id") @db.Uuid
  userId   String       @map("user_id") @db.Uuid
  /// 1..5, checked by zod and by a DB check constraint added in the migration.
  rating   Int
  text     String?      @db.Text
  status   ReviewStatus @default(PUBLISHED)

  authorReply     String?   @map("author_reply") @db.Text
  authorRepliedAt DateTime? @map("author_replied_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId, status])
  @@map("reviews")
}

model Notification {
  id      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String           @map("user_id") @db.Uuid
  type    NotificationType
  title   String           @db.VarChar(180)
  body    String?          @db.Text
  /// Deep link / entity ids for the frontend.
  payload Json?
  readAt  DateTime?        @map("read_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Complaints about different entity types. targetId is intentionally not an FK:
/// the target table is chosen by targetType at the service level.
model Complaint {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String              @map("reporter_id") @db.Uuid
  targetType ComplaintTargetType @map("target_type")
  targetId   String              @map("target_id") @db.Uuid
  reason     String              @db.VarChar(120)
  comment    String?             @db.Text
  status     ComplaintStatus     @default(OPEN)

  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolution   String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter   User  @relation("ComplaintReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ComplaintResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, targetType])
  @@index([targetType, targetId])
  @@map("complaints")
}

/// Audit trail of course status changes (needed for the admin panel and defense).
model ModerationLog {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String           @map("course_id") @db.Uuid
  moderatorId String?          @map("moderator_id") @db.Uuid
  action      ModerationAction
  fromStatus  CourseStatus     @map("from_status")
  toStatus    CourseStatus     @map("to_status")
  comment     String?          @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moderator User?  @relation("ModerationModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([courseId, createdAt])
  @@map("moderation_log")
}
