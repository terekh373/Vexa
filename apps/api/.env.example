# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Runtime ------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"

# --- Database -----------------------------------------------------------------
# Local Postgres runs on 5433: port 5432 may be taken by a native
# PostgreSQL Windows service. Keep docker-compose.yml in sync.
DATABASE_URL="postgresql://vexa:vexa@localhost:5433/vexa?schema=public"

# --- Cache / sessions ---------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth ---------------------------------------------------------------------
# Generate a unique value for each, minimum 32 characters:
#   node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- CORS ---------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:5173"

# --- Platform economics -------------------------------------------------------
# Default commission in basis points: 1500 = 15.00%
PLATFORM_COMMISSION_BPS="1500"
# Minimum payout amount, kopiykas: 50000 = 500.00 UAH
PAYOUT_MIN_AMOUNT="50000"
# Refund window in days (TZ section 26)
REFUND_WINDOW_DAYS="14"

# --- Object storage (S3-compatible) -------------------------------------------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="vexa-dev"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_SIGNED_URL_TTL_SEC="600"

# --- Video (Cloudflare Stream) ------------------------------------------------
CF_STREAM_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""

# --- Payments (sandbox only during the diploma) -------------------------------
PAYMENT_PROVIDER="LIQPAY"
LIQPAY_PUBLIC_KEY="sandbox_"
LIQPAY_PRIVATE_KEY="sandbox_"
PAYMENT_WEBHOOK_URL="http://localhost:3000/api/payments/webhook"
