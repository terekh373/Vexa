# Copy to .env and fill in every value. .env is git-ignored and must never be
# committed. Local development values are documented in the README (sections
# "Перший запуск" and "Змінні оточення й секрети"); production values come
# from the deploy platform (see the README "Деплой" section).

# --- Runtime ------------------------------------------------------------------
NODE_ENV=""
PORT=""

# --- Database -----------------------------------------------------------------
DATABASE_URL=""

# --- Cache / sessions ---------------------------------------------------------
REDIS_URL=""

# --- Auth ---------------------------------------------------------------------
# Generate a unique value for each, minimum 32 characters:
#   node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL=""
JWT_REFRESH_TTL=""

# --- Web client / CORS --------------------------------------------------------
# Base URL of the web client used in links emitted by the API. Must point to
# the frontend application, not to the API server.
WEB_APP_URL=""
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=""

# --- Transactional email (Brevo) --------------------------------------------
# Leave BREVO_API_KEY empty to log emails instead of sending them.
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME=""
SUPPORT_EMAIL=""

# --- Platform economics -------------------------------------------------------
# Default commission in basis points (1500 = 15.00%)
PLATFORM_COMMISSION_BPS=""
# Minimum payout amount, kopiykas (50000 = 500.00 UAH)
PAYOUT_MIN_AMOUNT=""
# Refund window in days (TZ section 26)
REFUND_WINDOW_DAYS=""

# --- Object storage (S3-compatible) -------------------------------------------
# Local: MinIO. Production: Cloudflare R2 —
#   S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto".
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Signed URL lifetime, seconds (SRS 20.2: 10 minutes)
S3_SIGNED_URL_TTL_SEC=""

# --- Video (Cloudflare Stream) ------------------------------------------------
# Stream API access for direct uploads. Set both together, or leave both empty:
# the API still starts, but video upload answers 503. The token needs the
# "Stream: Edit" permission.
CF_STREAM_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""
# Signing key for playback URLs (POST /accounts/{account_id}/stream/keys).
# Cloudflare shows the key's id and pem only once, at creation time.
# Set all three together, or leave all three empty (player falls back to
# video.status = "UNAVAILABLE"; TZ 20.2).
CF_STREAM_CUSTOMER_CODE=""
CF_STREAM_SIGNING_KEY_ID=""
# Base64 of the key's "pem" field, exactly as Cloudflare returned it.
CF_STREAM_SIGNING_KEY_PEM=""
# Signed playback URL lifetime, seconds.
STREAM_SIGNED_URL_TTL_SEC=""

# --- Payments ------------------------------------------------------------------
PAYMENT_PROVIDER=""
# Sandbox keys start with "sandbox_". Issued per account at liqpay.ua.
LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""
# Full URL LiqPay calls back on, e.g. https://<host>/api/payments/webhook.
PAYMENT_WEBHOOK_URL=""

# --- Seed data (apps/api/prisma/seed.ts) --------------------------------------
# "demo" seeds sample courses/users for local development.
# "production" seeds only categories and a single admin account.
SEED_MODE=""
# Required only when SEED_MODE=production. Login for the bootstrap admin account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
