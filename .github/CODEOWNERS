# Vexa — review ownership.
#
# The LAST matching rule wins, so the global fallback must stay at the top:
# every rule below it overrides it.
#
# GitHub excludes the PR author from its own reviewer list, and code owner
# review is required on develop and main. Every path therefore has at least
# two owners — otherwise an owner's PR has no eligible reviewer and cannot be
# merged.

# Global fallback: root configs, lockfile, compose file, README.
*                       @terekh373 @suberbobbr

# Backend: Team Lead + backend dev
/apps/api/              @terekh373 @suberbobbr

# Documentation: SRS, git workflow, and the API contract the web app is
# written against. Same owners as the backend — the contract and the code
# that implements it change together.
/docs/                  @terekh373 @suberbobbr

# Database contract: schema, migrations, seed.
/apps/api/prisma/       @terekh373 @suberbobbr
/docs/schema.dbml       @terekh373 @suberbobbr

# Shared contract between backend and clients
/packages/shared/       @terekh373 @suberbobbr

# Frontend web + mobile. The frontend devs review each other; the Team Lead
# and the backend dev stay owners because they ship web changes too.
# Any single approval satisfies the rule.
/apps/web/              @terekh373 @suberbobbr @devitfro @voer2
/apps/mobile/           @terekh373 @suberbobbr @devitfro @voer2

# Workflow configuration and this file itself.
/.github/               @terekh373 @suberbobbr
